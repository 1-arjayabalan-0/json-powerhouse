{
    "name": "json-powerhouse-vscode",
    "author": {
        "name": "Jaya Balan A R",
        "email": "jsonpowerhousesupport@codarivu.com",
        "url": ""
    },
    "icon": "assets/json-powerhouse-icon.png",
    "publisher": "arjayabalan",
    "repository": {
        "url": "https://github.com/1-arjayabalan-0/json-powerhouse",
        "directory": "json-powerhouse",
        "type": "github"
    },
    "license": "MIT",
    "displayName": "JSON Powerhouse - Fix JSON, Generate TypeScript, C#, SQL & Prisma",
    "description": "Fix broken JSON and generate TypeScript, C#, Go, Java and Python models, SQL CREATE TABLE scripts (PostgreSQL, MySQL, SQLite), Prisma schemas and JSON Schema — right inside your editor.",
    "keywords": [
        "json",
        "json formatter",
        "json to typescript",
        "json to c#",
        "fix invalid json",
        "json parser",
        "api response formatter",
        "json minify",
        "json validate",
        "json tree view",
        "json diff",
        "json to sql",
        "json to postgresql",
        "json to mysql",
        "json to prisma",
        "json schema generator"
    ],
    "version": "2.0.0",
    "engines": {
        "vscode": "^1.80.0"
    },
    "categories": [
        "Formatters",
        "Programming Languages"
    ],
    "activationEvents": [
        "onLanguage:json",
        "onLanguage:jsonc"
    ],
    "main": "./dist/extension/src/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "json-powerhouse.format",
                "title": "Format JSON",
                "category": "JSON PowerHouse"
            },
            {
                "command": "json-powerhouse.minify",
                "title": "Minify JSON",
                "category": "JSON PowerHouse"
            },
            {
                "command": "json-powerhouse.normalize",
                "title": "Normalize (Strip Comments)",
                "category": "JSON PowerHouse"
            },
            {
                "command": "json-powerhouse.toJson5",
                "title": "Convert to JSON5",
                "category": "JSON PowerHouse"
            },
            {
                "command": "json-powerhouse.flatten",
                "title": "Flatten JSON",
                "category": "JSON PowerHouse"
            },
            {
                "command": "json-powerhouse.unflatten",
                "title": "Unflatten JSON",
                "category": "JSON PowerHouse"
            },
            {
                "command": "json-powerhouse.validate",
                "title": "Validate JSON",
                "category": "JSON PowerHouse"
            },
            {
                "command": "json-powerhouse.treeView",
                "title": "Open Tree Viewer",
                "category": "JSON PowerHouse"
            },
            {
                "command": "json-powerhouse.diff",
                "title": "Compare with Another File (Diff)",
                "category": "JSON PowerHouse"
            },
            {
                "command": "json-powerhouse.applyFix",
                "title": "Apply Auto-Fix",
                "category": "JSON PowerHouse"
            },
            {
                "command": "json-powerhouse.generateCSharp",
                "title": "JSON → C# Classes",
                "category": "JSON PowerHouse"
            },
            {
                "command": "json-powerhouse.generateDart",
                "title": "JSON → Dart Classes",
                "category": "JSON PowerHouse"
            },
            {
                "command": "json-powerhouse.generateGo",
                "title": "JSON → Go Structs",
                "category": "JSON PowerHouse"
            },
            {
                "command": "json-powerhouse.generateJava",
                "title": "JSON → Java Classes",
                "category": "JSON PowerHouse"
            },
            {
                "command": "json-powerhouse.generateKotlin",
                "title": "JSON → Kotlin Classes",
                "category": "JSON PowerHouse"
            },
            {
                "command": "json-powerhouse.generatePhp",
                "title": "JSON → PHP Classes",
                "category": "JSON PowerHouse"
            },
            {
                "command": "json-powerhouse.generatePython",
                "title": "JSON → Python Classes",
                "category": "JSON PowerHouse"
            },
            {
                "command": "json-powerhouse.generateRust",
                "title": "JSON → Rust Structs",
                "category": "JSON PowerHouse"
            },
            {
                "command": "json-powerhouse.generateSwift",
                "title": "JSON → Swift Structs",
                "category": "JSON PowerHouse"
            },
            {
                "command": "json-powerhouse.generateTypeScript",
                "title": "JSON → TypeScript Interfaces",
                "category": "JSON PowerHouse"
            },
            {
                "command": "json-powerhouse.generatePostgreSql",
                "title": "JSON → PostgreSQL Tables",
                "category": "JSON PowerHouse"
            },
            {
                "command": "json-powerhouse.generateMySql",
                "title": "JSON → MySQL Tables",
                "category": "JSON PowerHouse"
            },
            {
                "command": "json-powerhouse.generateSqlite",
                "title": "JSON → SQLite Tables",
                "category": "JSON PowerHouse"
            },
            {
                "command": "json-powerhouse.generatePrisma",
                "title": "JSON → Prisma Schema",
                "category": "JSON PowerHouse"
            },
            {
                "command": "json-powerhouse.generateJsonSchema",
                "title": "JSON → JSON Schema",
                "category": "JSON PowerHouse"
            },
            {
                "command": "json-powerhouse.generate",
                "title": "All Generators… (C#, Java, Python, Go, SQLite, JSON Schema…)",
                "category": "JSON PowerHouse",
                "icon": "$(sparkle)"
            },
            {
                "command": "json-powerhouse.generatorOptions",
                "title": "Generator Options…",
                "category": "JSON PowerHouse",
                "icon": "$(settings-gear)"
            }
        ],
        "submenus": [
            {
                "id": "jsonPowerhouse.menu",
                "label": "JSON PowerHouse"
            },
            {
                "id": "jsonPowerhouse.transform",
                "label": "Transform"
            }
        ],
        "menus": {
            "editor/context": [
                {
                    "submenu": "jsonPowerhouse.menu",
                    "when": "editorLangId == json || editorLangId == jsonc",
                    "group": "navigation"
                }
            ],
            "jsonPowerhouse.menu": [
                {
                    "command": "json-powerhouse.format",
                    "group": "1_common@1"
                },
                {
                    "command": "json-powerhouse.minify",
                    "group": "1_common@2"
                },
                {
                    "command": "json-powerhouse.validate",
                    "group": "1_common@3"
                },
                {
                    "command": "json-powerhouse.generateTypeScript",
                    "group": "2_generate@1"
                },
                {
                    "command": "json-powerhouse.generatePostgreSql",
                    "group": "2_generate@2"
                },
                {
                    "command": "json-powerhouse.generateMySql",
                    "group": "2_generate@3"
                },
                {
                    "command": "json-powerhouse.generatePrisma",
                    "group": "2_generate@4"
                },
                {
                    "command": "json-powerhouse.generate",
                    "group": "2_generate@5"
                },
                {
                    "command": "json-powerhouse.generatorOptions",
                    "group": "2_generate@6"
                },
                {
                    "submenu": "jsonPowerhouse.transform",
                    "group": "3_more@1"
                },
                {
                    "command": "json-powerhouse.treeView",
                    "group": "3_more@2"
                },
                {
                    "command": "json-powerhouse.diff",
                    "group": "3_more@3"
                }
            ],
            "jsonPowerhouse.transform": [
                {
                    "command": "json-powerhouse.normalize",
                    "group": "1_transform@1"
                },
                {
                    "command": "json-powerhouse.toJson5",
                    "group": "1_transform@2"
                },
                {
                    "command": "json-powerhouse.flatten",
                    "group": "1_transform@3"
                },
                {
                    "command": "json-powerhouse.unflatten",
                    "group": "1_transform@4"
                }
            ],
            "commandPalette": [
                {
                    "command": "json-powerhouse.applyFix",
                    "when": "false"
                }
            ],
            "editor/title": [
                {
                    "command": "json-powerhouse.generate",
                    "when": "editorLangId == json || editorLangId == jsonc",
                    "group": "navigation@1"
                },
                {
                    "command": "json-powerhouse.generatorOptions",
                    "when": "jsonPowerhouse.isGeneratedOutput",
                    "group": "navigation@1"
                }
            ]
        },
        "configuration": [
            {
                "id": "json-powerhouse",
                "title": "JSON PowerHouse",
                "order": 0,
                "properties": {
                    "json-powerhouse.formatting.indentation": {
                        "type": "string",
                        "default": "2",
                        "enum": [
                            "2",
                            "4",
                            "tab",
                            "0"
                        ],
                        "description": "Default indentation for formatting"
                    },
                    "json-powerhouse.formatting.keySorting": {
                        "type": "string",
                        "default": "none",
                        "enum": [
                            "none",
                            "asc",
                            "desc"
                        ],
                        "description": "Sort object keys"
                    },
                    "json-powerhouse.formatting.quoteStyle": {
                        "type": "string",
                        "default": "double",
                        "enum": [
                            "double",
                            "single"
                        ],
                        "description": "Quote style for keys"
                    },
                    "json-powerhouse.formatting.trailingCommas": {
                        "type": "boolean",
                        "default": false,
                        "description": "Add trailing commas"
                    },
                    "json-powerhouse.formatting.stripComments": {
                        "type": "boolean",
                        "default": true,
                        "description": "Strip comments from JSON"
                    },
                    "json-powerhouse.diff.allowComments": {
                        "type": "boolean",
                        "default": true,
                        "description": "Allow comments in JSON for diff comparison"
                    },
                    "json-powerhouse.diff.arrayStrategy": {
                        "type": "string",
                        "default": "index",
                        "enum": [
                            "index",
                            "key",
                            "ignore-order"
                        ],
                        "description": "Array comparison strategy for diff"
                    },
                    "json-powerhouse.diff.arrayMatchKey": {
                        "type": "string",
                        "default": "id",
                        "description": "Key to match array items when using key-based strategy"
                    },
                    "json-powerhouse.diff.showUnchanged": {
                        "type": "boolean",
                        "default": false,
                        "description": "Show unchanged nodes in diff view"
                    },
                    "json-powerhouse.validateOnSave": {
                        "type": "boolean",
                        "default": true,
                        "description": "Automatically validate JSON on save"
                    },
                    "json-powerhouse.validateOnChange": {
                        "type": "boolean",
                        "default": true,
                        "description": "Automatically validate JSON on change (debounced)"
                    },
                    "json-powerhouse.telemetry.enabled": {
                        "type": "boolean",
                        "default": true,
                        "tags": [
                            "usesOnlineServices",
                            "telemetry"
                        ],
                        "markdownDescription": "Send anonymous usage statistics (which commands are used; never your JSON). Always off when VS Code telemetry (`#telemetry.telemetryLevel#`) is off. See the Telemetry section of the README."
                    }
                }
            },
            {
                "id": "json-powerhouse.typescript",
                "title": "TypeScript",
                "order": 10,
                "properties": {
                    "json-powerhouse.typescript.typeKind": {
                        "type": "string",
                        "default": "interface",
                        "description": "Plain interfaces only, or interfaces plus Convert helpers that parse and check JSON at runtime.",
                        "order": 0,
                        "enum": [
                            "type",
                            "interface"
                        ],
                        "enumItemLabels": [
                            "Interfaces only",
                            "Interfaces + Convert helpers"
                        ]
                    },
                    "json-powerhouse.typescript.runtimeTypecheck": {
                        "type": "string",
                        "default": "none",
                        "description": "Also generate a runtime validation schema.",
                        "order": 1,
                        "enum": [
                            "none",
                            "zod"
                        ],
                        "enumItemLabels": [
                            "None",
                            "Zod schema"
                        ]
                    },
                    "json-powerhouse.typescript.readonlyProperties": {
                        "type": "boolean",
                        "default": false,
                        "description": "Mark every property as readonly.",
                        "order": 2
                    },
                    "json-powerhouse.typescript.explicitAny": {
                        "type": "boolean",
                        "default": false,
                        "description": "Use \"any\" instead of \"unknown\" for values whose type cannot be inferred.",
                        "order": 3
                    },
                    "json-powerhouse.typescript.nicePropertyNames": {
                        "type": "boolean",
                        "default": true,
                        "description": "Convert JSON keys into idiomatic property names.",
                        "order": 4
                    },
                    "json-powerhouse.typescript.acronymStyle": {
                        "type": "string",
                        "default": "camel",
                        "description": "How acronyms such as \"URL\" or \"ID\" are cased in generated names.",
                        "order": 5,
                        "enum": [
                            "camel",
                            "pascal",
                            "lowerCase",
                            "upperCase",
                            "original"
                        ],
                        "enumItemLabels": [
                            "Camel (Url, Id)",
                            "Pascal (URL, ID)",
                            "Lower case (url, id)",
                            "Upper case (URL, ID)",
                            "Keep original"
                        ]
                    }
                }
            },
            {
                "id": "json-powerhouse.csharp",
                "title": "C#",
                "order": 11,
                "properties": {
                    "json-powerhouse.csharp.namespace": {
                        "type": "string",
                        "default": "MyNamespace",
                        "description": "Namespace for the generated types.",
                        "order": 0
                    },
                    "json-powerhouse.csharp.framework": {
                        "type": "string",
                        "default": "SystemTextJson",
                        "description": "Serialization attributes to emit.",
                        "order": 1,
                        "enum": [
                            "SystemTextJson",
                            "NewtonsoftJson",
                            "none"
                        ],
                        "enumItemLabels": [
                            "System.Text.Json",
                            "Newtonsoft.Json",
                            "None (plain types)"
                        ]
                    },
                    "json-powerhouse.csharp.recordType": {
                        "type": "string",
                        "default": "class",
                        "description": "Generate classes, records or structs.",
                        "order": 2,
                        "enum": [
                            "class",
                            "record",
                            "struct"
                        ],
                        "enumItemLabels": [
                            "Class",
                            "Record",
                            "Struct"
                        ]
                    },
                    "json-powerhouse.csharp.accessLevel": {
                        "type": "string",
                        "default": "public",
                        "description": "Access modifier of the generated types.",
                        "order": 3,
                        "enum": [
                            "public",
                            "internal"
                        ],
                        "enumItemLabels": [
                            "public",
                            "internal"
                        ]
                    },
                    "json-powerhouse.csharp.numberType": {
                        "type": "string",
