                        "description": "C# type used for JSON arrays.",
                        "order": 5,
                        "enum": [
                            "list",
                            "array"
                        ],
                        "enumItemLabels": [
                            "List<T>",
                            "T[]"
                        ]
                    },
                    "json-powerhouse.csharp.density": {
                        "type": "string",
                        "default": "normal",
                        "description": "Normal or dense (more compact) output.",
                        "order": 6,
                        "enum": [
                            "normal",
                            "dense"
                        ],
                        "enumItemLabels": [
                            "Normal",
                            "Dense"
                        ]
                    }
                }
            },
            {
                "id": "json-powerhouse.java",
                "title": "Java",
                "order": 12,
